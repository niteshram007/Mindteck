const SITE_URL = (
  process.env.NEXT_PUBLIC_DOMAIN?.startsWith("http")
    ? process.env.NEXT_PUBLIC_DOMAIN
    : `https://${process.env.NEXT_PUBLIC_DOMAIN || "www.mindteck.com"}`
).replace(/\/+$/, "");

const stripHtml = (value = "") =>
  String(value || "").replace(/<[^>]*>/g, " ");

export const normalizeMetadataText = (value = "") =>
  stripHtml(value)
    .replace(/\s+/g, " ")
    .replace(/\s([,.;:!?])/g, "$1")
    .trim();

const normalizeKeywords = (value = "") =>
  normalizeMetadataText(value).replace(/\s*,\s*/g, ", ");

const toCanonicalPath = (value = "/") => {
  const normalizedValue = String(value || "").trim();
  if (!normalizedValue) {
    return "/";
  }

  if (/^https?:\/\//i.test(normalizedValue)) {
    const withoutOrigin = normalizedValue.replace(SITE_URL, "");
    return withoutOrigin.startsWith("/") ? withoutOrigin : `/${withoutOrigin}`;
  }

  return normalizedValue.startsWith("/") ? normalizedValue : `/${normalizedValue}`;
};

export const extractSummary = (value = "", maxLength = 160) => {
  const normalizedValue = normalizeMetadataText(value);
  if (!normalizedValue) {
    return "";
  }

  if (normalizedValue.length <= maxLength) {
    return normalizedValue;
  }

  const clippedValue = normalizedValue.slice(0, maxLength + 1);
  const lastSpaceIndex = clippedValue.lastIndexOf(" ");
  const summary =
    lastSpaceIndex > Math.floor(maxLength * 0.6)
      ? clippedValue.slice(0, lastSpaceIndex)
      : clippedValue.slice(0, maxLength);

  return `${summary.trim()}...`;
};

export const buildPageMetadata = ({
  title,
  description,
  keywords,
  canonicalPath,
  openGraphType = "website",
  image,
}) => {
  const normalizedTitle = normalizeMetadataText(title);
  const normalizedDescription = normalizeMetadataText(description);
  const normalizedKeywords = normalizeKeywords(keywords);
  const canonical = toCanonicalPath(canonicalPath);
  const canonicalUrl = new URL(canonical, `${SITE_URL}/`).toString();
  const resolvedTitle = normalizedTitle ? `${normalizedTitle} | Mindteck` : "Mindteck";

  const metadata = {
    title: resolvedTitle,
    description: normalizedDescription,
    metadataBase: new URL(SITE_URL),
    alternates: {
      canonical: canonicalUrl,
    },
    openGraph: {
      title: resolvedTitle,
      description: normalizedDescription,
      url: canonicalUrl,
      siteName: "Mindteck",
      locale: "en_US",
      type: openGraphType,
    },
    twitter: {
      card: "summary_large_image",
      title: resolvedTitle,
      description: normalizedDescription,
    },
  };

  if (normalizedKeywords) {
    metadata.keywords = normalizedKeywords;
  }

  if (image) {
    metadata.openGraph.images = [image];
  }

  return metadata;
};

